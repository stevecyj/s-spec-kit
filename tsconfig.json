{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "backend/src/**/*.js",
    "backend/tests/**/*.js",
    "frontend/src/**/*.js",
    "frontend/vite.config.js",
    "frontend/playwright.config.js",
    "frontend/tests/**/*.js"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
}
